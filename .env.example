# ============================================================================
# FD-Sales: Cloud Environment Variables Configuration
# Copy this file to .env.local and fill in the actual values from Supabase
# ============================================================================

# --- SUPABASE CONFIGURATION ---
# استخراج من https://supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- APPLICATION ENVIRONMENT ---
# development | staging | production
VITE_APP_ENV=development

# --- OPTIONAL FEATURES ---
# FingerprintJS Pro API Key (optional - free tier works too)
VITE_FINGERPRINT_JS_API_KEY=

# Railway deployment URL (auto-filled on Railway)
VITE_APP_URL=http://localhost:5173

# --- LOGGING LEVEL ---
# debug | info | warn | error
VITE_LOG_LEVEL=info

# --- RATE LIMITING ---
# عدد طلبات API المسموحة في الدقيقة
VITE_API_RATE_LIMIT=60

# --- SESSION TIMEOUT (minutes) ---
VITE_SESSION_TIMEOUT=60

# --- DEVICE FINGERPRINT CACHE TTL (minutes) ---
VITE_DEVICE_CACHE_TTL=480
